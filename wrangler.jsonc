{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jimvanduijsen-com",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-07",
  "build": {
    "command": "pnpm build:css",
  },
  "assets": {
    "directory": "./public",
  },
  "routes": [
    {
      "pattern": "www.jimvanduijsen.com",
      "custom_domain": true,
    },
  ],
  "dev": {
    "ip": "0.0.0.0",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
