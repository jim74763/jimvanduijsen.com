# Resend SMTP settings: https://resend.com/docs/send-with-smtp
# Copy to .env (or .dev.vars for Wrangler local development).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
# Replace with your Resend API key: https://resend.com/api-keys
SMTP_PASS=re_your_api_key

# Replace with the inbox that should receive contact form submissions.
CONTACT_TO_EMAIL=you@example.com
# Replace with a sender address on your verified Resend domain.
CONTACT_FROM_EMAIL=contact@your-verified-domain.com
