{
  "name": "jimvanduijsen.com",
  "type": "module",
  "scripts": {
    "build": "pnpm build:css",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/assets/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./public/assets/app.css --watch=always",
    "dev": "concurrently \"pnpm watch:css\" \"wrangler pages dev\"",
    "deploy": "pnpm build:css && wrangler pages deploy"
  },
  "dependencies": {
    "hono": "^4.12.18",
    "lucide-react": "^1.14.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.4",
    "wrangler": "^4.4.0"
  }
}
